<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.gold-price-monitor" path="/org/gnome/shell/extensions/gold_price_monitor/">
    <key name="api-provider" type="i">
      <default>0</default>
      <summary>API Provider</summary>
    </key>
    <key name="api-key" type="s">
      <default>""</default>
      <summary>API Key</summary>
    </key>
    <key name="weight-unit" type="i">
      <default>0</default>
      <summary>Weight Unit</summary>
      <description>Gold Weight Unit.</description>
    </key>
    <key name="currency" type="i">
      <default>0</default>
      <summary>Currency</summary>
      <description>Gold Currency.</description>
    </key>
    <key name="refresh-interval" type="i">
      <default>12</default>
      <summary>Refresh interval in Minutes</summary>
      <description>Refresh interval in Minutes(set to 0 for manual refresh).</description>
    </key>
    <key name="hide-unit" type="b">
      <default>false</default>
    </key>
    <key name="hide-symbols" type="b">
      <default>false</default>
      <summary>Hide Symbols</summary>
      <description>Toggle to hide or show metal symbols in the display.</description>
    </key>
    <key name="panel-position" type="i">
      <default>2</default>
    </key>
    <key name="show-gold" type="b">
      <default>true</default>
      <summary>Show Gold</summary>
      <description>Track gold price (XAU).</description>
    </key>
    <key name="show-silver" type="b">
      <default>false</default>
      <summary>Show Silver</summary>
      <description>Track silver price (XAG).</description>
    </key>
  </schema>
</schemalist>